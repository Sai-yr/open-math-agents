private theorem sorted_noCycle {a b c d : ℕ} (ha : 0 < a) (hb : 0 < b) (sum : a+b+c+d=311)
    (ab : a ≤ b) (ac : a ≤ c) (cd : c ≤ d) (edges : opposite a b c d) : False := by
  have az := necessarySupport sum edges
  obtain ⟨h₁,h₂,h₃,h₄,h₅,h₆⟩ := edges
  have cz := necessarySupport (a:=c) (b:=d) (c:=a) (d:=b) (by omega)
    ⟨h₂,h₁,fun h => h₃ h.symm,fun h => h₅ h.symm,fun h => h₄ h.symm,fun h => h₆ h.symm⟩
  have dz := necessarySupport (a:=d) (b:=c) (c:=a) (d:=b) (by omega)
    ⟨h₂.symm,h₁,fun h => h₄ h.symm,fun h => h₆ h.symm,fun h => h₃ h.symm,fun h => h₅ h.symm⟩
  have checked := certified_noCycle ⟨a,by omega⟩
  change noCycleAt a = true at checked
  simp only [noCycleAt,az,bne_self_eq_false,Bool.false_or] at checked
  have cm : c ∈ neighbors a := by simp [neighbors,ac,cz,h₃]; omega
  have dm : d ∈ neighbors a := by simp [neighbors,show a ≤ d by omega,dz,h₄]; omega
  have h := List.all_eq_true.mp (List.all_eq_true.mp checked c cm) d dm
  have hh : c ≤ d → a+c+d < 311 → a ≤ 311-a-c-d → a.Coprime (311-a-c-d) → c.Coprime d → (311-a-c-d).Coprime c ∨ (311-a-c-d).Coprime d := of_decide_eq_true h
  have eq : 311-a-c-d=b := by omega
  rw [eq] at hh
  exact (hh cd (by omega) ab h₁ h₂).elim h₅ h₆

private theorem leftSwap {a b c d : ℕ} (h : opposite a b c d) : opposite b a c d := by
  obtain ⟨h₁,h₂,h₃,h₄,h₅,h₆⟩ := h
  exact ⟨h₁.symm,h₂,h₅,h₆,h₃,h₄⟩

private theorem flip {a b c d : ℕ} (h : opposite a b c d) : opposite c d a b := by
  obtain ⟨h₁,h₂,h₃,h₄,h₅,h₆⟩ := h
  exact ⟨h₂,h₁,fun g => h₃ g.symm,fun g => h₅ g.symm,fun g => h₄ g.symm,fun g => h₆ g.symm⟩

private theorem noCycle {a b c d : ℕ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d)
    (sum : a+b+c+d=311) (edges : opposite a b c d) : False := by
  have ordered (i j k l : ℕ) (hi : 0 < i) (hj : 0 < j) (hk : 0 < k) (hl : 0 < l)
      (hs : i+j+k+l=311) (e : opposite i j k l) (ij : i ≤ j) (kl : k ≤ l) : False := by
    rcases le_total i k with h|h
    · exact sorted_noCycle hi hj hs ij h kl e
    · exact sorted_noCycle hk hl (by omega) kl h ij (flip e)
  rcases le_total a b with ab|ba <;> rcases le_total c d with cd|dc
  · exact ordered a b c d ha hb hc hd sum edges ab cd
  · exact ordered a b d c ha hb hd hc (by omega) (flip (leftSwap (flip edges))) ab dc
  · exact ordered b a c d hb ha hc hd (by omega) (leftSwap edges) ba cd
  · exact ordered d c b a hd hc hb ha (by omega) (leftSwap (flip (leftSwap edges))) dc ba


/-! Six-bit masks are canonically labeled by independently evaluating all 24 vertex permutations. -/
private def label : Array ℕ := #[0,1,1,3,1,3,3,7,1,3,3,11,12,13,13,15,1,3,12,13,3,11,13,15,3,7,13,15,13,15,30,31,1,12,3,13,3,13,11,15,3,13,7,15,13,30,15,31,3,13,13,30,7,15,15,31,11,15,15,31,15,31,31,63]

private theorem label_ok (g : Fin 64) : canonical g.val = label[g.val]! := by
  revert g
  decide +kernel

private theorem mask_lt (a b c d : ℕ) : mask a b c d < 64 := by
  unfold mask
  split_ifs <;> decide

private theorem periodic_coprime {a M d : ℕ} (ha : a ∣ M^10) (q : ℕ) :
    a.Coprime (d+M*q) ↔ a.Coprime d := by
  apply not_iff_not.mp
  simp only [Nat.Prime.not_coprime_iff_dvd]
  constructor <;> rintro ⟨p,hp,hpa,hpd⟩
  · have hpm : p ∣ M := hp.dvd_of_dvd_pow (hpa.trans ha)
    exact ⟨p,hp,hpa,(Nat.dvd_add_iff_left (dvd_mul_of_dvd_left hpm q)).mpr hpd⟩
  · exact ⟨p,hp,hpa,dvd_add hpd (dvd_mul_of_dvd_left (hp.dvd_of_dvd_pow (hpa.trans ha)) q)⟩

/-! The certificate encodes the three fixed parts as the digits of a base-2048 integer. The fourth part is the remaining summand. -/
private def aa (w : ℕ) := w / 2048^2
private def bb (w : ℕ) := w / 2048 % 2048
private def cc (w : ℕ) := w % 2048

private def good (R n w : ℕ) : Bool :=
  let a := aa w
  let b := bb w
  let c := cc w
  decide (0<a ∧ 0<b ∧ 0<c ∧ a+b+c<n ∧ label[mask a b c (n-a-b-c)]! = R)

private def smooth (M w : ℕ) : Bool :=
  decide (aa w ∣ M^10 ∧ bb w ∣ M^10 ∧ cc w ∣ M^10)

private theorem useRow {g : Fin 64} {R n M w : ℕ} (hg : canonical g.val = R)
    (goodRow : good R n w) (q : ℕ) (period : q = 0 ∨ smooth M w) :
    represented (n+M*q) g.val := by
  obtain ⟨ha,hb,hc,hs,hmask⟩ : 0<aa w ∧ 0<bb w ∧ 0<cc w ∧ aa w+bb w+cc w<n ∧
      label[mask (aa w) (bb w) (cc w) (n-aa w-bb w-cc w)]! = R := of_decide_eq_true goodRow
  let d := n-aa w-bb w-cc w
  refine ⟨aa w,bb w,cc w,d+M*q,ha,hb,hc,by dsimp [d]; omega,by dsimp [d]; omega,?_⟩
  rw [hg]
  have exactMask : canonical (mask (aa w) (bb w) (cc w) d) = R :=
    (label_ok ⟨_,mask_lt _ _ _ _⟩).trans hmask
  rcases period with rfl | hh
  · simpa using exactMask
  · obtain ⟨h₁,h₂,h₃⟩ : aa w ∣ M^10 ∧ bb w ∣ M^10 ∧ cc w ∣ M^10 := of_decide_eq_true hh
    simpa only [mask,periodic_coprime h₁,periodic_coprime h₂,periodic_coprime h₃] using exactMask

/-! Each residue has a witness at its first eligible sum and a liftable witness one modulus later. Kernel evaluation checks both rows. -/
private def rowTest (M R lo : ℕ) (A B : Array ℕ) (i : ℕ) : Bool :=
  let n := 312+lo+i
  good R n A[i]! && good R (n+M) B[i]! && smooth M B[i]!

private theorem chunk {R M lo size n : ℕ} {g : Fin 64} (A B : Array ℕ)
    (check : (List.range size).all (rowTest M R lo A B)) (hg : canonical g.val = R)
    (hn : 312 ≤ n) (_hp : 0 < M) (lower : lo ≤ (n-312)%M)
    (upper : (n-312)%M < lo+size) : represented n g.val := by
  let i := (n-312)%M-lo
  let q := (n-312)/M
  have hi : i < size := by dsimp [i]; omega
  have sum : n = 312+lo+i + M*q := by
    have h := Nat.mod_add_div (n-312) M
    dsimp [i,q]; omega
  have ht := List.all_eq_true.mp check i (List.mem_range.mpr hi)
  obtain ⟨h₁,h₂,h₃⟩ : good R (312+lo+i) A[i]! ∧ good R (312+lo+i+M) B[i]! ∧ smooth M B[i]! := by
    simpa only [rowTest,Bool.and_eq_true,and_assoc] using ht
  cases hq : q with
  | zero =>
    rw [sum,hq]
    exact useRow hg h₁ 0 (Or.inl rfl)
  | succ j =>
    rw [sum,hq,Nat.mul_succ]
    convert useRow hg h₂ j (Or.inr h₃) using 1; omega


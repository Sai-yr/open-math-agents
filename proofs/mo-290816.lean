private theorem supportCertificate (a : Fin 312) : supportWitness[a.val]! = 0 ∨
    (supportWitness[a.val]!).Prime ∧ a.val ∣ (2*supportWitness[a.val]!)^10 := by
  revert a
  decide +kernel

private theorem necessarySupport {a b c d : ℕ} (sum : a+b+c+d=311) (e : opposite a b c d) :
    supportWitness[a]! = 0 := by
  rcases supportCertificate ⟨a,by omega⟩ with yes | ⟨hp,hdvd⟩
  · exact yes
  · obtain ⟨ab,cd,ac,ad,_,_⟩ := e
    obtain ⟨p,pp,pa,pc⟩ := Nat.Prime.not_coprime_iff_dvd.mp ac
    obtain ⟨q,pq,qa,qd⟩ := Nat.Prime.not_coprime_iff_dvd.mp ad
    have nodouble (x y : ℕ) (h : x.Coprime y) (even : 2 ∣ x) : ¬ 2 ∣ y :=
      fun h₂ => (Nat.Prime.not_coprime_iff_dvd.mpr ⟨2,Nat.prime_two,even,h₂⟩) h
    have po : p ≠ 2 := by
      rintro rfl
      have := nodouble a b ab pa
      have := nodouble c d cd pc
      omega
    have qo : q ≠ 2 := by
      rintro rfl
      have := nodouble a b ab qa
      have := nodouble d c cd.symm qd
      omega
    have single {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2) (hra : r ∣ a) :
        r = supportWitness[a]! := by
      rcases hr.dvd_mul.mp (hr.dvd_of_dvd_pow (hra.trans hdvd)) with h|h
      · exact (hr2 ((Nat.dvd_prime Nat.prime_two).mp h |>.resolve_left hr.ne_one)).elim
      · exact ((Nat.dvd_prime hp).mp h).resolve_left hr.ne_one
    have eq := (single pp po pa).trans (single pq qo qa).symm
    exact False.elim ((Nat.Prime.not_coprime_iff_dvd.mpr ⟨p,pp,pc,eq ▸ qd⟩) cd)

private def neighbors (a : ℕ) : List ℕ :=
  (List.range 312).filter fun c => decide (a ≤ c ∧ supportWitness[c]! = 0 ∧ ¬ a.Coprime c)

private def noCycleAt (a : ℕ) : Bool :=
  supportWitness[a]! != 0 || (neighbors a).all fun c => (neighbors a).all fun d =>
    let b := 311-a-c-d
    decide (c ≤ d → a+c+d < 311 → a ≤ b → a.Coprime b → c.Coprime d → b.Coprime c ∨ b.Coprime d)


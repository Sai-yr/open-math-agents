private theorem negative : ¬ represented 311 30 := by
  rintro ⟨a,b,c,d,ha,hb,hc,hd,hs,eq⟩
  have hh : label[mask a b c d]! = 30 := by
    rw [← label_ok ⟨_,mask_lt _ _ _ _⟩]; exact eq.trans (by decide +kernel)
  have form : opposite a b c d ∨ opposite a c b d ∨ opposite a d b c := by
    unfold mask at hh
    split_ifs at hh <;> first
      | exact False.elim ((by decide +kernel : ¬ _) hh)
      | (simp_all [opposite,Nat.coprime_comm]; constructor <;> assumption)
  exact form.elim (noCycle ha hb hc hd hs) (fun h => h.elim
    (noCycle ha hc hb hd (by omega)) (noCycle ha hd hb hc (by omega)))

